{
  "name": "arca-siradig",
  "version": "1.1.0",
  "description": "CLI to inspect, update, print and submit ARCA SiRADIG Form 572 drafts.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jpgarcia/arca-siradig.git"
  },
  "homepage": "https://github.com/jpgarcia/arca-siradig#readme",
  "bugs": {
    "url": "https://github.com/jpgarcia/arca-siradig/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "bin": {
    "arca-siradig": "./dist/src/cli/index.js"
  },
  "files": [
    "dist/src/**/*.js",
    "dist/src/**/*.d.ts",
    "README.md",
    "LICENSE",
    "docs/mcp.md"
  ],
  "engines": {
    "node": "^20.17.0 || ^22.13.0 || >=23.5.0"
  },
  "scripts": {
