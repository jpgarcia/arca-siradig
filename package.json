    "@types/node": "^25.9.3",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.5.2",
    "@modelcontextprotocol/server": "^2.3.1",
    "dotenv": "^17.4.2",
    "playwright": "^1.61.0",
    "zod": "^4.6.5"
  }
}
